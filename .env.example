# Public product identifier used only to enable the upgrade button in the browser.
VITE_DODO_PRODUCT_ID=pdt_your_product_id

# Server-only Vercel environment variables. Never expose these with a VITE_ prefix.
DODO_PAYMENTS_API_KEY=your_test_mode_api_key
DODO_PAYMENTS_PRODUCT_ID=pdt_your_product_id
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=https://your-domain.example/?checkout=success
DODO_PAYMENTS_CANCEL_URL=https://your-domain.example/?checkout=cancelled
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_signing_secret

# Composio-managed Google Calendar connection.
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_AUTH_CONFIG_ID=your_composio_google_calendar_auth_config_id
COMPOSIO_USER_ID=your_upnext_user_id
COMPOSIO_REDIRECT_URI=https://your-domain.example/api/composio/callback
